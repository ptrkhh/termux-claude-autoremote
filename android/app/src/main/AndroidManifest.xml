<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets this app ask Termux to run ~/bin/claude-launch. Termux must also be
         configured with `allow-external-apps=true` in ~/.termux/termux.properties
         (see the repo README). -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- Android 11+ filters package queries: without this, getPackageInfo()
         reports Termux as missing and getLaunchIntentForPackage() returns null
         even when it is installed, so the setup screen would show ✗ for apps
         that are actually there. -->
    <queries>
        <package android:name="com.termux" />
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!-- The launch screen. singleTop with onNewIntent: without a launch mode
             it is `standard`, and a NEW_TASK share into an already-open launcher
             brings the task forward while dropping the new intent — you would
             launch yesterday's folder. singleTask was rejected: it changes task
             affinity for an app that is also a share target. -->
        <activity
            android:name=".LaunchActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SetupActivity"
            android:exported="false" />

        <!-- The share-sheet target. Its label is what shows in the Android
             "Share" menu: "Open Claude Code here". Translucent so it never shows
             a screen; it finishes itself once the hand-off is done. (No
             noHistory here — that can destroy the activity while the runtime
             permission dialog is on screen.) -->
        <activity
            android:name=".ShareActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:label="@string/share_label"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>
    </application>
</manifest>

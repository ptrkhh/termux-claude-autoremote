#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

CFG="$HOME/.config/claude-launch"
RECENTS="$CFG/recents"
CAP=15
# resume picker: hide trivial/unresumable sessions with fewer than this many
# assistant turns in their transcript — kills /login-only, one-liners, aborted,
# and "no conversation found" shells. ponytail: bump if real short sessions hide.
MIN_TURNS=3
MODELS="opus,sonnet,haiku,fable"
EFFORTS="low,medium,high,xhigh,max"
# Widget used for every picker. Termux:API's `sheet` is a BottomSheetDialog and
# it never sets a peek height or asks for the expanded state, so on some devices
# it opens as a collapsed sliver at the bottom edge — only the first row shows
# (often clipped) until you swipe it up. `radio` is an ordinary centred
# AlertDialog that sizes itself to its content and scrolls, so the whole list is
# on screen from the first tap, at the cost of one extra tap on OK. Set
# CLAUDE_LAUNCH_PICKER=sheet to get the old one-tap sheet back (or `spinner`).
PICKER="${CLAUDE_LAUNCH_PICKER:-radio}"
case "$PICKER" in
  radio|sheet|spinner) ;;
  *) echo "claude-launch: unknown CLAUDE_LAUNCH_PICKER '$PICKER' — using radio" >&2
     PICKER=radio ;;
esac
# codenames make each Remote Control session easy to spot in the app
ANIMALS=(cat dog fox owl bear wolf lion tiger panda koala otter seal hawk duck frog deer)
PINNED=(
  "$HOME"                    # Termux home
  "$HOME/git"                # projects
  "$HOME/storage/shared"     # Android home  (/storage/emulated/0)
  "$HOME/storage/downloads"  # Android downloads
)

# ---------- pure helpers (unit-tested via --selftest) ----------

# mru_add NEW CAP   (current list on stdin) -> deduped, capped list on stdout
mru_add() {
  awk -v new="$1" -v cap="$2" '
    function emit(x){ if(!(x in seen) && n<cap){ seen[x]=1; print x; n++ } }
    BEGIN{ if(new!="") emit(new) }
    NF{ emit($0) }
  '
}

# go_up PATH ROOT -> parent of PATH, never above ROOT
go_up() {
  local parent root
  root="${2%/}"; root="${root:-/}"
  parent=$(dirname "$1")
  case "$parent" in
    "$root"|"$root"/*) printf '%s\n' "$parent" ;;
    *)                 printf '%s\n' "$root" ;;
  esac
}

# list_subdirs PATH -> immediate subdirectory basenames, sorted (dotdirs skipped).
# Names containing a newline are dropped: newline frames the --ls wire format, so
# such a name would reach the app as two rows that both fail [ -d ]. Newline-named
# directories are legal on Android, so this is reachable, not theoretical.
list_subdirs() (
  shopt -s nullglob
  local d name
  for d in "$1"/*/; do
    d=${d%/}; name=${d##*/}
    if [ "$name" = "${name//$'\n'/}" ]; then printf '%s\n' "$name"; fi
  done | sort
)

# sanitize TEXT -> TEXT with tabs, CRs and newlines collapsed to spaces.
# Load-bearing, not cosmetic: a raw TAB in aiTitle shifts every later TSV column.
sanitize() { printf '%s' "$1" | tr '\t\n\r' '   '; }

# valid_choice VALUE CSV -> 0 if VALUE is a member of the comma-separated CSV.
# Surrounding both sides with commas makes prefix matches ("opu") and trailing
# junk ("opus,") fail, and an empty VALUE fails because CSV has no empty member.
#
# The comma guard is load-bearing, not defensive noise: without it
# `valid_choice sonnet,haiku "opus,sonnet,haiku,fable"` ACCEPTS, because
# ",opus,sonnet,haiku,fable," really does contain ",sonnet,haiku,". A value
# holding a comma can never be a single member of a comma-separated list, so
# rejecting it up front is both correct and the shortest fix. (Glob characters
# need no guard — `",$1,"` is quoted, so a `*` is matched literally.)
valid_choice() {
  case "$1" in *,*) return 1 ;; esac
  case ",$2," in
    *",$1,"*) return 0 ;;
    *)        return 1 ;;
  esac
}

# bridge_id SESSION_JSON -> the RC bridgeSessionId ("" if file/field absent).
# claude writes ~/.claude/sessions/<pid>.json once it registers remote control.
# Always exits 0 (grep/head can exit nonzero under `set -o pipefail`).
bridge_id() { grep -oE '"bridgeSessionId":"[^"]+"' "$1" 2>/dev/null | head -1 | cut -d'"' -f4 || true; }

# usable_prompts  (stdin: prompts, one per line) -> "meaningful" prompts, one per
# line, in order. Drops slash-commands, a small stopword set, and blank lines —
# the noise that otherwise makes a session summary read "exit / ok / /resume".
usable_prompts() {
  awk '
    function trim(s){ gsub(/^[ \t]+|[ \t]+$/,"",s); return s }
    BEGIN{ split("continue resume exit usage ok yes no quit y n",a," "); for(i in a) stop[tolower(a[i])]=1 }
    { t=trim($0); if(t=="") next; if(substr(t,1,1)=="/") next; if(tolower(t) in stop) next; print t }
  '
}

# stitch3  (stdin: lines) -> the last 3 lines joined with " · " (no trailing sep).
# Fewer than 3 lines -> joins whatever there is; 0 lines -> empty string.
stitch3() {
  awk '{a[NR]=$0} END{ s=NR>3?NR-2:1; for(i=s;i<=NR;i++) printf "%s%s",(i>s?" · ":""),a[i]; print "" }'
}

# ---------- selftest ----------

# expect_rc CODE CMD... -> assert CMD exits with CODE, else fail the selftest.
# The capture through `|| rc=$?` is mandatory: under `set -e` a bare failing
# command aborts the script before any `[ "$?" -eq N ]` on the next line can run,
# so the naive form silently exits 2 instead of asserting anything.
expect_rc() {
  local want=$1 rc=0
  shift
  "$@" >/dev/null 2>&1 || rc=$?
  [ "$rc" -eq "$want" ] || { echo "expect_rc FAIL: wanted $want, got $rc, from: $*"; exit 1; }
}

selftest() {
  local out t
  out=$(printf 'b\nc\n'    | mru_add a 5); [ "$out" = $'a\nb\nc' ] || { echo "mru_add basic FAIL: [$out]"; exit 1; }
  out=$(printf 'a\nb\n'    | mru_add a 5); [ "$out" = $'a\nb' ]    || { echo "mru_add dedupe FAIL: [$out]"; exit 1; }
  out=$(printf 'x\na\ny\n' | mru_add a 5); [ "$out" = $'a\nx\ny' ] || { echo "mru_add reorder FAIL: [$out]"; exit 1; }
  out=$(printf 'b\nc\nd\n' | mru_add a 2); [ "$out" = $'a\nb' ]    || { echo "mru_add cap FAIL: [$out]"; exit 1; }
  out=$(go_up /r/a/b /r);  [ "$out" = /r/a ] || { echo "go_up FAIL: [$out]"; exit 1; }
  out=$(go_up /r/a/b /r/); [ "$out" = /r/a ] || { echo "go_up trailing-slash FAIL: [$out]"; exit 1; }
  out=$(go_up /r /r);      [ "$out" = /r ]   || { echo "go_up root-clamp FAIL: [$out]"; exit 1; }
  t=$(mktemp -d); mkdir -p "$t/x" "$t/y" "$t/.hidden" "$t/has space" "$t/$(printf 'new\nline')"; touch "$t/f"
  out=$(list_subdirs "$t" | paste -sd,); rm -rf "$t"
  [ "$out" = "has space,x,y" ] || { echo "list_subdirs newline-drop FAIL: [$out]"; exit 1; }
  out=$(sanitize "$(printf 'a\tb\nc')")
  [ "$out" = "a b c" ] || { echo "sanitize FAIL: [$out]"; exit 1; }
  out=$(sanitize "plain")
  [ "$out" = "plain" ] || { echo "sanitize passthrough FAIL: [$out]"; exit 1; }
  valid_choice opus "$MODELS"    || { echo "valid_choice member FAIL"; exit 1; }
  valid_choice fable "$MODELS"   || { echo "valid_choice last-member FAIL"; exit 1; }
  valid_choice low "$EFFORTS"    || { echo "valid_choice first-member FAIL"; exit 1; }
  ! valid_choice opu "$MODELS"   || { echo "valid_choice prefix FAIL"; exit 1; }
  ! valid_choice "" "$MODELS"    || { echo "valid_choice empty FAIL"; exit 1; }
  ! valid_choice sonnet,haiku "$MODELS" || { echo "valid_choice injection FAIL"; exit 1; }
  expect_rc 0 true
  expect_rc 3 bash -c 'exit 3'
  t=$(mktemp); printf '{"pid":1,"bridgeSessionId":"session_ABC123","x":2}' >"$t"
  out=$(bridge_id "$t"); rm -f "$t"
  [ "$out" = session_ABC123 ]      || { echo "bridge_id FAIL: [$out]"; exit 1; }
  out=$(bridge_id /no/such/file);  [ -z "$out" ] || { echo "bridge_id missing-file FAIL: [$out]"; exit 1; }
  out=$(printf '/resume\nsession picker\nlooks right\nok\nconsult ponytail\n' | usable_prompts | stitch3)
  [ "$out" = "session picker · looks right · consult ponytail" ] || { echo "stitch basic FAIL: [$out]"; exit 1; }
  out=$(printf 'a\nb\nc\nd\ne\n' | usable_prompts | stitch3)
  [ "$out" = "c · d · e" ]                                       || { echo "stitch last3 FAIL: [$out]"; exit 1; }
  out=$(printf '/effort\n  \nEXIT\nYes\nreal work\n' | usable_prompts | stitch3)
  [ "$out" = "real work" ]                                       || { echo "stitch suppress FAIL: [$out]"; exit 1; }
  out=$(printf '/resume\nok\nexit\n' | usable_prompts | stitch3)
  [ -z "$out" ]                                                  || { echo "stitch empty FAIL: [$out]"; exit 1; }
  t=$(mktemp -d); mkdir -p "$t/work" "$t/git" "$t/.config/claude-launch"
  printf '%s\n' "$t/work" "$t/gone" > "$t/.config/claude-launch/recents"
  out=$(HOME="$t" "$BASH" "$0" --state)
  printf '%s\n' "$out" | grep -qx "recents$(printf '\t')$t/work" || { echo "state recents FAIL: [$out]"; exit 1; }
  printf '%s\n' "$out" | grep -q  "$t/gone"                       && { echo "state emitted missing recent FAIL"; exit 1; }
  printf '%s\n' "$out" | grep -qx "pinned$(printf '\t')$t"        || { echo "state pinned home FAIL: [$out]"; exit 1; }
  printf '%s\n' "$out" | grep -qx "pinned$(printf '\t')$t/git"    || { echo "state pinned git FAIL: [$out]"; exit 1; }
  printf '%s\n' "$out" | grep -q  "storage"                       && { echo "state emitted absent pinned FAIL"; exit 1; }
  printf '%s\n' "$out" | grep -qx "models$(printf '\t')opus sonnet haiku fable" || { echo "state models FAIL: [$out]"; exit 1; }
  printf '%s\n' "$out" | grep -qx "efforts$(printf '\t')low medium high xhigh max" || { echo "state efforts FAIL: [$out]"; exit 1; }
  [ "$(printf '%s\n' "$out" | grep -c '^claude')" -eq 1 ] || { echo "state claude tag count FAIL: [$out]"; exit 1; }
  out=$(PATH=/nonexistent HOME="$t" "$BASH" "$0" --state | grep '^claude')
  [ "$out" = "claude$(printf '\t')0" ] || { echo "state claude-absent FAIL: [$out]"; exit 1; }
  printf '%s\n' "$t/work" "$t/gone" > "$t/.config/claude-launch/recents"
  HOME="$t" "$BASH" "$0" --state >/dev/null
  [ "$(wc -l < "$t/.config/claude-launch/recents")" -eq 2 ] || { echo "state must not prune recents FAIL"; exit 1; }
  rm -rf "$t"
  t=$(mktemp -d); mkdir -p "$t/alpha" "$t/beta" "$t/$(printf 'bad\nname')"; touch "$t/file"
  out=$("$BASH" "$0" --ls "$t" | paste -sd,)
  [ "$out" = "alpha,beta" ] || { echo "--ls FAIL: [$out]"; exit 1; }
  out=$("$BASH" "$0" --ls "$t/alpha")
  [ -z "$out" ] || { echo "--ls empty-dir FAIL: [$out]"; exit 1; }
  expect_rc 2 "$BASH" "$0" --ls
  rm -rf "$t"
  t=$(mktemp -d); mkdir -p "$t/.claude/projects/p" "$t/proj"
  printf '{"sessionId":"s1","project":"%s","timestamp":1700000000000,"display":"/resume"}\n' "$t/proj" >  "$t/.claude/history.jsonl"
  printf '{"sessionId":"s1","project":"%s","timestamp":1700000001000,"display":"real work here"}\n' "$t/proj" >> "$t/.claude/history.jsonl"
  printf '{"sessionId":"s1","project":"%s","timestamp":1700000002000,"display":"ok"}\n' "$t/proj" >> "$t/.claude/history.jsonl"
  for _ in 1 2 3; do printf '{"type":"assistant"}\n' >> "$t/.claude/projects/p/s1.jsonl"; done
  # `\\t` so the FILE contains the two-character JSON escape \t, not raw tab bytes.
  # A literal tab inside a JSON string is invalid JSON and jq rejects the whole
  # line (verified: "control characters from U+0000 through U+001F must be
  # escaped"). Since the title lookup swallows jq errors with `2>/dev/null || true`,
  # a raw tab would silently blank the title, fall back to the first prompt, and
  # fail the cut -f6 assertion for a reason unrelated to the code under test.
  # jq decodes \t back to a real tab on output, so this still exercises `sanitize`.
  printf '{"type":"ai-title","aiTitle":"Title\\twith\\ttabs"}\n' >> "$t/.claude/projects/p/s1.jsonl"
  out=$(HOME="$t" "$BASH" "$0" --sessions)
  [ "$(printf '%s\n' "$out" | wc -l)" -eq 1 ] || { echo "--sessions row count FAIL: [$out]"; exit 1; }
  [ "$(printf '%s' "$out" | awk -F'\t' '{print NF}')" -eq 7 ] || { echo "--sessions arity FAIL: [$out]"; exit 1; }
  [ "$(printf '%s' "$out" | cut -f1)" = s1 ]      || { echo "--sessions sid FAIL"; exit 1; }
  [ "$(printf '%s' "$out" | cut -f3)" = proj ]    || { echo "--sessions folder FAIL"; exit 1; }
  [ "$(printf '%s' "$out" | cut -f6)" = "Title with tabs" ] || { echo "--sessions title sanitize FAIL: [$(printf '%s' "$out" | cut -f6)]"; exit 1; }
  [ "$(printf '%s' "$out" | cut -f7)" = "real work here" ]  || { echo "--sessions summary FAIL: [$(printf '%s' "$out" | cut -f7)]"; exit 1; }
  # a session below MIN_TURNS is not resumable
  : > "$t/.claude/projects/p/s1.jsonl"; printf '{"type":"assistant"}\n' > "$t/.claude/projects/p/s1.jsonl"
  out=$(HOME="$t" "$BASH" "$0" --sessions)
  [ -z "$out" ] || { echo "--sessions MIN_TURNS FAIL: [$out]"; exit 1; }
  # no history at all -> zero lines, exit 0
  rm -f "$t/.claude/history.jsonl"
  out=$(HOME="$t" "$BASH" "$0" --sessions) || { echo "--sessions empty FAIL: capture failed"; exit 1; }
  [ -z "$out" ] || { echo "--sessions empty FAIL: [$out]"; exit 1; }
  rm -rf "$t"
  t=$(mktemp -d); mkdir -p "$t/proj" "$t/.config/claude-launch"
  out=$(CLAUDE_LAUNCH_DRYRUN=1 HOME="$t" "$BASH" "$0" --launch --dir "$t/proj" --model opus --effort high)
  case "$out" in
    "cd $t/proj && claude --model opus --effort high --dangerously-skip-permissions --remote-control "*) ;;
    *) echo "--launch dryrun FAIL: [$out]"; exit 1 ;;
  esac
  out=$(CLAUDE_LAUNCH_DRYRUN=1 HOME="$t" "$BASH" "$0" --launch --dir "$t/proj" --resume abc123)
  case "$out" in
    "cd $t/proj && claude --resume abc123 --dangerously-skip-permissions --remote-control "*) ;;
    *) echo "--launch resume dryrun FAIL: [$out]"; exit 1 ;;
  esac
  # DRYRUN must not mutate: no recents file, no ~/.claude.json
  [ ! -e "$t/.config/claude-launch/recents" ] || { echo "--launch dryrun wrote recents FAIL"; exit 1; }
  [ ! -e "$t/.claude.json" ]                  || { echo "--launch dryrun wrote claude.json FAIL"; exit 1; }
  # grammar. expect_rc, not `cmd; [ "$?" -eq 2 ]` — see Task 1.
  export CLAUDE_LAUNCH_DRYRUN=1
  expect_rc 2 env HOME="$t" "$BASH" "$0" --launch --dir "$t/proj" --model gpt  --effort high
  expect_rc 2 env HOME="$t" "$BASH" "$0" --launch --dir "$t/proj" --model opus --effort turbo
  expect_rc 2 env HOME="$t" "$BASH" "$0" --launch --dir "$t/proj"
  expect_rc 2 env HOME="$t" "$BASH" "$0" --launch --dir "$t/nope" --model opus --effort high
  expect_rc 2 env HOME="$t" "$BASH" "$0" --launch --dir "$t/proj" --model opus --effort high --bogus x
  unset CLAUDE_LAUNCH_DRYRUN
  rm -rf "$t"
  echo "selftest OK"
}

# ---------- dialog helpers (interactive; verified via CLAUDE_LAUNCH_DRYRUN=1) ----------
# ponytail: termux-dialog -v is a comma-joined list with no escaping, so dir
# names containing ',' break selection parsing. Rare on Android paths; switch to
# an indexed dialog if it ever bites.

# menu TITLE CSV -> selected text on stdout ("" if cancelled).
# Cancel/dismiss/back reports code BUTTON_NEGATIVE with an empty .text for every
# widget type, so "empty result" means cancelled regardless of $PICKER.
menu() {
  termux-dialog "$PICKER" -t "$1" -v "$2" | jq -r '.text // empty'
}

# menu_index TITLE CSV -> 0-based index of the selected row ("" if cancelled).
# Needed for the resume list: row labels are free text (titles/prompts) and are
# not safe to match by value, so we map the selection back by position instead.
# .index is omitted entirely when nothing was picked, hence the -1 default.
menu_index() {
  termux-dialog "$PICKER" -t "$1" -v "$2" \
    | jq -r 'if (.text // "") == "" or (.index // -1) < 0 then empty else (.index|tostring) end'
}

# list_sessions -> TAB-separated "ms_epoch<TAB>cwd<TAB>session_id<TAB>prompts",
# newest first, up to 60 candidates. Source is ~/.claude/history.jsonl, grouped by
# sessionId. `prompts` is that session's display strings joined by ␟, carried
# here so emit_sessions does not re-read history.jsonl once per row (up to 20 full
# re-reads before this change). ␟ survives jq's @tsv unescaped; tabs and
# newlines inside a prompt do not, which is what keeps the framing intact.
# ponytail: history.jsonl is rotated/capped by claude (~300 lines), so a very
# chatty session can push older ones out of this list. Fine for "recent"; fall
# back to a projects/*/*.jsonl mtime scan only if a wanted session goes missing.
list_sessions() {
  [ -f "$HOME/.claude/history.jsonl" ] || return 0
  jq -rs '
    group_by(.sessionId)
    | map({sid:.[0].sessionId,
           cwd:(map(.project)|last),
           ts:((map(.timestamp)|max) // 0),
           prompts:(map(.display // "" | gsub("\n";" ")))})
    | sort_by(-.ts) | .[0:60][]
    | [(.ts|tostring), .cwd, .sid, (.prompts|join(""))] | @tsv
  ' "$HOME/.claude/history.jsonl"
}

# emit_sessions -> up to 20 resumable sessions as 7-column TSV:
#   sid, cwd, folder, branch, when, title, summary
# No header and no terminator: zero lines means "nothing to resume", and the app
# distinguishes that from version skew by column count, not by a marker. (A
# terminal marker cannot detect truncation anyway — Termux truncates the result
# bundle from the start, so the last line is the one that always survives.)
# Resumable = transcript exists and holds at least MIN_TURNS assistant turns.
emit_sessions() {
  local ts cwd sid prompts f title branch summary folder when lines kept=0
  while IFS=$'\t' read -r ts cwd sid prompts; do
    [ "$kept" -ge 20 ] && break
    [ -d "$cwd" ] || continue
    local -a matches=( "$HOME/.claude/projects/"*/"$sid.jsonl" )
    f="${matches[0]}"; [ -e "$f" ] || continue        # transcript gone -> not resumable
    # -m stops the read at MIN_TURNS matches instead of scanning a whole
    # multi-megabyte transcript; -c then prints min(count, MIN_TURNS), so the
    # -ge test below is unchanged.
    [ "$(grep -c -m "$MIN_TURNS" '"type":"assistant"' "$f" 2>/dev/null || true)" -ge "$MIN_TURNS" ] || continue
    title=$(grep -m1 '"type":"ai-title"' "$f" 2>/dev/null | jq -r '.aiTitle // empty' 2>/dev/null || true)
    branch=$(grep -m1 '"gitBranch":"[^"]' "$f" 2>/dev/null | jq -r '.gitBranch // empty' 2>/dev/null || true)
    [ "$branch" = HEAD ] && branch=""                 # detached / non-repo -> no useful label
    lines="${prompts//$'\x1f'/$'\n'}"
    summary=$(printf '%s\n' "$lines" | usable_prompts | stitch3)
    [ -n "$title" ] || title=$(printf '%s\n' "$lines" | usable_prompts | head -1)
    folder=$(basename "$cwd")
    when=$(date -d "@$(( ts / 1000 ))" '+%m-%d %H:%M' 2>/dev/null || true)
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
      "$sid" "$cwd" "$(sanitize "$folder")" "$(sanitize "$branch")" \
      "$when" "$(sanitize "$title")" "$(sanitize "$summary")"
    kept=$((kept+1))
  done < <(list_sessions)
}

# pick_session -> on a chosen session sets SID + DIR (caller's locals) and returns.
# Cancel / no sessions -> exits the whole script cleanly (no launch).
# Lists up to 20 resumable sessions: the transcript must exist and hold at least
# MIN_TURNS assistant turns (drops /login-only, one-liners, aborted, and "no
# conversation found" shells). Each row is 3 lines (folder/branch/date, aiTitle,
# stitched last-3-prompt summary). Commas are stripped from labels because
# termux-dialog -v splits rows on commas (the ceiling noted on menu()).
pick_session() {
  local ts cwd sid f title branch prompts summary folder when l1 l2 l3 label idx l kept=0
  local -a LABELS=() SIDS=() CWDS=()
  while IFS=$'\t' read -r ts cwd sid prompts; do
    [ "$kept" -ge 20 ] && break
    [ -d "$cwd" ] || continue
    local -a matches=( "$HOME/.claude/projects/"*/"$sid.jsonl" )
    f="${matches[0]}"; [ -e "$f" ] || continue        # transcript gone -> not resumable
    [ "$(grep -c '"type":"assistant"' "$f" 2>/dev/null || true)" -ge "$MIN_TURNS" ] || continue
    title=$(grep -m1 '"type":"ai-title"' "$f" 2>/dev/null | jq -r '.aiTitle // empty' 2>/dev/null || true)
    branch=$(grep -m1 '"gitBranch":"[^"]' "$f" 2>/dev/null | jq -r '.gitBranch // empty' 2>/dev/null || true)
    [ "$branch" = HEAD ] && branch=""                 # detached / non-repo -> no useful label
    prompts=$(jq -r --arg s "$sid" 'select(.sessionId==$s) | (.display // "" | gsub("\n";" "))' "$HOME/.claude/history.jsonl" 2>/dev/null || true)
    summary=$(printf '%s\n' "$prompts" | usable_prompts | stitch3)
    [ -n "$title" ] || title=$(printf '%s\n' "$prompts" | usable_prompts | head -1)
    folder=$(basename "$cwd")
    when=$(date -d "@$(( ts / 1000 ))" '+%m-%d %H:%M' 2>/dev/null || true)
    l1="$folder${branch:+ ($branch)}${when:+ · $when}"
    l2="${title:-(untitled)}"
    l3="${summary:+  ↳ $summary}"
    label="$l1"$'\n'"$l2"
    [ -n "$l3" ] && label="$label"$'\n'"$l3"
    label="${label//,/;}"
    LABELS+=("$label"); SIDS+=("$sid"); CWDS+=("$cwd"); kept=$((kept+1))
  done < <(list_sessions)

  if [ "${#LABELS[@]}" -eq 0 ]; then
    termux-toast -s "No sessions to resume" 2>/dev/null || true
    exit 0
  fi
  local csv=""
  for l in "${LABELS[@]}"; do csv="${csv:+$csv,}$l"; done
  idx=$(menu_index "Resume session" "$csv")
  [ -n "$idx" ] || exit 0
  SID="${SIDS[idx]}"; DIR="${CWDS[idx]}"
}

# recents_shown -> existing recents not equal to a pinned dir, one per line
recents_shown() {
  [ -f "$RECENTS" ] || return 0
  local line p skip
  while IFS= read -r line; do
    [ -d "$line" ] || continue
    skip=0
    for p in "${PINNED[@]}"; do
      if [ "$line" = "$p" ]; then skip=1; break; fi
    done
    if [ "$skip" = 0 ]; then printf '%s\n' "$line"; fi
  done < "$RECENTS"
}

# emit_state -> the launch screen's opening payload, as tagged lines.
#
# Read-only by contract. It deliberately does NOT call prune_recents:
# recents_shown already skips paths that no longer exist, so pruning would change
# the emitted tags by nothing, and its only effect is rewriting $RECENTS. The app
# re-fires --state on every onCreate (including rotation), so pruning here would
# permanently drop any recent whose path is *transiently* absent — an unmounted
# ~/storage/*, a revoked storage permission — on every app open.
#
# `claude` is always emitted, 1 or 0. Omitting it when claude is missing would
# trip the app's required-tag check and report a healthy launcher as version skew.
emit_state() {
  local p line
  recents_shown | while IFS= read -r line; do printf 'recents\t%s\n' "$line"; done
  for p in "${PINNED[@]}"; do
    if [ -d "$p" ]; then printf 'pinned\t%s\n' "$p"; fi
  done
  printf 'models\t%s\n' "${MODELS//,/ }"
  printf 'efforts\t%s\n' "${EFFORTS//,/ }"
  if command -v claude >/dev/null 2>&1; then
    printf 'claude\t1\n'
  else
    printf 'claude\t0\n'
  fi
}

# prune_recents -> rewrite recents keeping only dirs that still exist
prune_recents() {
  [ -f "$RECENTS" ] || return 0
  local line tmp
  tmp=$(mktemp)
  while IFS= read -r line; do
    if [ -d "$line" ]; then printf '%s\n' "$line"; fi
  done < "$RECENTS" > "$tmp"
  mv "$tmp" "$RECENTS"
}

# browse ROOT -> chosen dir on stdout ("" if cancelled)
browse() {
  local root=$1 cur=$1 sel subs csv
  while true; do
    subs=$(list_subdirs "$cur")
    csv="✅ Open here"
    if [ "$cur" != "$root" ]; then csv="⬆ ..,$csv"; fi
    if [ -n "$subs" ]; then csv="$csv,$(printf '%s' "$subs" | paste -sd,)"; fi
    sel=$(menu "$cur" "$csv")
    case "$sel" in
      "")            return 0 ;;
      "✅ Open here") printf '%s\n' "$cur"; return 0 ;;
      "⬆ ..")        cur=$(go_up "$cur" "$root") ;;
      *)             cur="$cur/$sel" ;;
    esac
  done
}

# pick_dir -> sets DIR (uses caller's locals)
pick_dir() {
  local csv="🔁 Resume session…" sel p recents_list
  prune_recents
  recents_list=$(recents_shown)
  if [ -n "$recents_list" ]; then csv="${csv:+$csv,}$(printf '%s' "$recents_list" | paste -sd,)"; fi
  for p in "${PINNED[@]}"; do csv="${csv:+$csv,}$p"; done
  csv="${csv:+$csv,}📁 Browse Termux,📱 Browse Android"

  sel=$(menu "Working directory" "$csv")
  case "$sel" in
    "")                exit 0 ;;
    "🔁 Resume session…") pick_session; return ;;
    "📁 Browse Termux") DIR=$(browse "$HOME") ;;
    "📱 Browse Android") DIR=$(browse "$HOME/storage/shared") ;;
    *)                 DIR="$sel" ;;
  esac
  if [ -z "$DIR" ]; then exit 0; fi   # browse cancelled
}

pick_model()  { MODEL=$(menu "Model" "$MODELS");   if [ -z "$MODEL" ];  then exit 0; fi; }
pick_effort() { EFFORT=$(menu "Effort" "$EFFORTS"); if [ -z "$EFFORT" ]; then exit 0; fi; }

# save_state -> update recents (MRU, capped)
save_state() {
  mkdir -p "$CFG"
  local cur=""
  [ -f "$RECENTS" ] && cur=$(cat "$RECENTS")
  printf '%s\n' "$cur" | mru_add "$DIR" "$CAP" > "$RECENTS.tmp"
  mv "$RECENTS.tmp" "$RECENTS"
}

# trust_dir DIR -> mark DIR as trusted in ~/.claude.json so claude skips the
# folder-trust dialog on startup (--dangerously-skip-permissions does NOT cover
# it). That dialog otherwise blocks the remote-control banner until tapped.
trust_dir() {
  local cfg="$HOME/.claude.json" tmp
  [ -f "$cfg" ] || printf '{}' > "$cfg"
  tmp=$(mktemp)
  if jq --arg d "$1" '.projects[$d].hasTrustDialogAccepted = true' "$cfg" > "$tmp"; then
    mv "$tmp" "$cfg"
  else
    rm -f "$tmp"   # leave cfg untouched on jq error; dialog is a survivable fallback
  fi
}

# require_api -> fail fast if Termux:API isn't responding. The termux-api CLI
# hangs forever broadcasting to a missing/broken app (looks like "nothing
# happens"), so probe with a timeout instead of trusting package presence.
require_api() {
  timeout 3 termux-battery-status >/dev/null 2>&1 && return 0
  echo "Termux:API not responding — install/reinstall the Termux:API app" >&2
  echo "(same source as Termux; the 'termux-api' CLI package alone is not enough)." >&2
  exit 1
}

# launch -> validate, then hand the terminal to claude. Reads DIR/MODEL/EFFORT/SID
# from the caller. Order matters: every check runs before trust_dir, because
# trust_dir writes hasTrustDialogAccepted into ~/.claude.json for a caller-supplied
# path, and that path now arrives from a client-side browse UI across a version
# boundary.
launch() {
  if [ -z "$DIR" ] || [ ! -d "$DIR" ]; then
    echo "claude-launch: not a directory: $DIR" >&2
    exit 2
  fi
  # Deleting pick_model/pick_effort deleted the only thing that enforced this:
  # those functions could not emit a non-member and exited 0 on empty.
  if [ -z "$SID" ]; then
    if ! valid_choice "$MODEL" "$MODELS"; then
      echo "claude-launch: invalid --model '$MODEL' (want one of $MODELS)" >&2
      exit 2
    fi
    if ! valid_choice "$EFFORT" "$EFFORTS"; then
      echo "claude-launch: invalid --effort '$EFFORT' (want one of $EFFORTS)" >&2
      exit 2
    fi
  fi
  # ponytail: folder + HH:MM + animal codename makes each session easy to spot;
  # collides only if two same-minute launches draw the same animal (~1/16).
  local rc_name
  rc_name="$(basename "$DIR") $(date +%H:%M) ${ANIMALS[RANDOM % ${#ANIMALS[@]}]}"
  local -a cmd
  if [ -n "$SID" ]; then
    cmd=(claude --resume "$SID" --dangerously-skip-permissions --remote-control "$rc_name")
  else
    cmd=(claude --model "$MODEL" --effort "$EFFORT" --dangerously-skip-permissions --remote-control "$rc_name")
  fi
  # Exits before every mutation below, which is what makes the selftest safe to
  # run against a real $HOME. It also means trust_dir and save_state have no
  # automated coverage — see the spec's declared gap.
  if [ -n "${CLAUDE_LAUNCH_DRYRUN:-}" ]; then
    printf 'cd %q && %s\n' "$DIR" "${cmd[*]}"
    exit 0
  fi
  if [ -z "$SID" ]; then          # resume carries its own model/effort + writes no state
    prune_recents
    save_state
  fi
  trust_dir "$DIR"
  cd "$DIR"
  # claude records its RC session at ~/.claude/sessions/<pid>.json once it
  # registers; a background watcher reads bridgeSessionId there and deep-links
  # into the app — `am start -d` cold-starts the app AND opens the exact thread.
  # We exec claude so its pid == our shell pid ($$), naming the file.
  # ponytail: no app pre-boot — `monkey`/activity-launch don't work under Termux,
  # and the deep-link launches the app itself. Bump the wait if the RC handshake
  # ever runs longer than 30s.
  local sf="$HOME/.claude/sessions/$$.json"
  (
    bid=""
    for _ in $(seq 1 60); do
      bid=$(bridge_id "$sf")
      if [ -n "$bid" ]; then
        am start -a android.intent.action.VIEW -d "https://claude.ai/code/$bid" >/dev/null 2>&1 || true
        break
      fi
      sleep 0.5
    done
  ) &
  exec "${cmd[@]}"
}

main() {
  require_api
  # PRESET_DIR (set by `--dir`, e.g. from the "Open Claude Code here" share
  # target) skips the working-directory picker and starts in that folder.
  local DIR="${PRESET_DIR:-}" MODEL="" EFFORT="" SID=""
  if [ -n "$DIR" ]; then
    if [ ! -d "$DIR" ]; then
      termux-toast -s "Folder not found — $DIR" 2>/dev/null || true
      echo "claude-launch: not a directory: $DIR" >&2
      exit 1
    fi
  else
    pick_dir
  fi
  if [ -z "$SID" ]; then          # resume carries its own model/effort + writes no state
    pick_model
    pick_effort
    save_state
  fi
  # ponytail: folder + HH:MM + animal codename makes each session easy to spot;
  # collides only if two same-minute launches draw the same animal (~1/16).
  local rc_name
  rc_name="$(basename "$DIR") $(date +%H:%M) ${ANIMALS[RANDOM % ${#ANIMALS[@]}]}"
  local cmd
  if [ -n "$SID" ]; then
    cmd=(claude --resume "$SID" --dangerously-skip-permissions --remote-control "$rc_name")
  else
    cmd=(claude --model "$MODEL" --effort "$EFFORT" --dangerously-skip-permissions --remote-control "$rc_name")
  fi
  if [ -n "${CLAUDE_LAUNCH_DRYRUN:-}" ]; then
    printf 'cd %q && %s\n' "$DIR" "${cmd[*]}"
    exit 0
  fi
  trust_dir "$DIR"
  cd "$DIR"
  termux-toast -s "Claude '$rc_name' — open under Code sessions in the app" 2>/dev/null || true
  # claude records its RC session at ~/.claude/sessions/<pid>.json once it
  # registers; a background watcher reads bridgeSessionId there and deep-links
  # into the app — `am start -d` cold-starts the app AND opens the exact thread.
  # We exec claude so its pid == our shell pid ($$), naming the file. If the id
  # never appears (~30s), the toast names the session as a backstop.
  # ponytail: no app pre-boot — `monkey`/activity-launch don't work under
  # Termux, and the deep-link launches the app itself. Bump the wait if the RC
  # handshake ever runs longer than 30s.
  local sf="$HOME/.claude/sessions/$$.json"
  (
    bid=""
    for _ in $(seq 1 60); do
      bid=$(bridge_id "$sf")
      if [ -n "$bid" ]; then
        am start -a android.intent.action.VIEW -d "https://claude.ai/code/$bid" >/dev/null 2>&1 || true
        break
      fi
      sleep 0.5
    done
  ) &
  exec "${cmd[@]}"
}

case "${1:-}" in
  --selftest) selftest ;;
  --state)    emit_state ;;
  --ls)
    shift
    if [ -z "${1:-}" ]; then
      echo "claude-launch: --ls requires a path" >&2
      exit 2
    fi
    list_subdirs "$1"
    ;;
  --sessions) emit_sessions ;;
  --launch)
    shift
    DIR=""; MODEL=""; EFFORT=""; SID=""
    while [ $# -gt 0 ]; do
      case "$1" in
        --dir)    DIR="${2:-}";    [ -n "$DIR" ]    || { echo "claude-launch: --dir requires a path" >&2; exit 2; };    shift 2 ;;
        --model)  MODEL="${2:-}";  [ -n "$MODEL" ]  || { echo "claude-launch: --model requires a value" >&2; exit 2; }; shift 2 ;;
        --effort) EFFORT="${2:-}"; [ -n "$EFFORT" ] || { echo "claude-launch: --effort requires a value" >&2; exit 2; };shift 2 ;;
        --resume) SID="${2:-}";    [ -n "$SID" ]    || { echo "claude-launch: --resume requires an id" >&2; exit 2; };  shift 2 ;;
        *) echo "claude-launch: unknown --launch option '$1'" >&2; exit 2 ;;
      esac
    done
    launch
    ;;
  --dir)
    shift
    PRESET_DIR="${1:-}"
    if [ -z "$PRESET_DIR" ]; then
      echo "claude-launch: --dir requires a path" >&2
      exit 2
    fi
    main
    ;;
  *)          main ;;
esac
